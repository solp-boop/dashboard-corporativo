# Copiá este archivo como .streamlit/secrets.toml (local) o pegá su contenido
# en Streamlit Cloud → App → Settings → Secrets. NUNCA subas secrets.toml a GitHub.

# (Opcional) IDs de las planillas. Si no se definen, se usan los de config/settings.py.
[sheets]
tablero = "1uDV3-CK5aeb-PI81uNc54t4L50HhscHe5xkp-pL9SyI"
cotizaciones = "1UJ1bDyDQdIQSSVQ6dyChVKbMX1d69G68ji_dpsOzfHg"

# (Opcional, recomendado) Cuenta de servicio de Google Cloud (JSON de la clave).
# Sin esta sección, el tablero lee las planillas por su enlace público.
# Con ella, las planillas pueden ser privadas: compartilas con client_email como "Lector".
[gcp_service_account]
type = "service_account"
project_id = "tu-proyecto"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nXXXX...\n-----END PRIVATE KEY-----\n"
client_email = "dashboard@tu-proyecto.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/dashboard%40tu-proyecto.iam.gserviceaccount.com"

# (Solo desarrollo) leer .xlsx exportados en lugar de Google Sheets.
# Se usa únicamente si NO hay [gcp_service_account].
# [local_files]
# tablero = "data/Tablero LI.xlsx"
# cotizaciones = "data/Cotizacion fletes internacionales.xlsx"
